/* The application: the shell under src/, the shared UI in packages/ui and every module's ui/ folder. */
/* @studio/core comes in through those imports. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../../out/renderer-tsc",
    "types": []
  },
  "include": ["src/**/*.ts", "../../packages/ui/src/**/*.ts", "../../packages/modules/ui.ts", "../../packages/modules/*/ui/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}

{
  "name": "plan-studio",
  "productName": "Plan Studio",
  "version": "0.1.0",
  "description": "Design buildings, floor plans, interiors and decor, with AI built in.",
  "private": true,
  "main": "./out/main/index.js",
  "author": {
    "name": "Besher Karam",
    "email": "besher.karam.1998@gmail.com"
  },
  "workspaces": [
    "packages/*",
    "src/renderer"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build && npm run build -w @studio/renderer",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && npm run typecheck -w @studio/renderer",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke",
    "package": "npm run build && electron-builder --publish never",
    "icon": "electron scripts/render-icon.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.19.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
